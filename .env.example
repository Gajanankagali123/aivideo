# ---------- Core ----------
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
FRONTEND_URL=http://localhost:8080

# ---------- Database ----------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_motion_studio

# ---------- Redis / Queue ----------
REDIS_URL=redis://localhost:6379

# ---------- Auth ----------
JWT_ACCESS_SECRET=replace_with_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
COOKIE_SECURE=false

# ---------- Storage (local dev fallback; swap to S3 in production) ----------
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# ---------- AI Providers (leave blank to use mock/local providers) ----------
VIDEO_PROVIDER=mock
VIDEO_PROVIDER_API_KEY=

VOICE_PROVIDER=mock
VOICE_PROVIDER_API_KEY=

AVATAR_PROVIDER=mock
AVATAR_PROVIDER_API_KEY=

# ---------- Payments (leave blank to use mock/dev-mode billing) ----------
PAYMENT_PROVIDER=mock
PAYMENT_PROVIDER_SECRET=
PAYMENT_WEBHOOK_SECRET=

# ---------- Rate limiting ----------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
